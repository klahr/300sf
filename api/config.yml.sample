# Copy to config.yml and fill in. Durations are in seconds.
data-source: "USERNAME:PASSWORD@tcp(127.0.0.1:3306)/300sf?charset=utf8mb4&parseTime=True&loc=Local"
address: ":8090"
mode: "debug"            # gin mode: debug | release
log-level: "warn"        # silent | error | warn | info
redis-host: "127.0.0.1:6379"
hashing-secret: "change-me"
domain: "http://localhost:3000"  # webapp base URL, used in email links
access-token-lifetime: 3600
refresh-token-lifetime: 2592000
default-api-soft-limit: 1000
default-api-hard-limit: 2000
api-call-counter-ttl: 86400
default-lists: []
wikipedia-cache-duration: 604800
mailjet-public-key: ""
mailjet-secret-key: ""
send-email-interval: 0       # 0 disables the email sender
delete-accounts-interval: 0  # 0 disables account deletion job
