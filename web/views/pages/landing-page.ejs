<%- contentFor('body') %>
<% const lang = getLocale(); %>

<header class="hero-image">
	<nav class="lang wrap" aria-label="<%= __('Language') %>">
		<a href="/?lang=sv" hreflang="sv" lang="sv" aria-current="<%= lang === 'sv' %>">Svenska</a>
		<a href="/?lang=en" hreflang="en" lang="en" aria-current="<%= lang === 'en' %>">English</a>
		<a href="https://app.300sf.se/home" class="text-link"><%= __('SignIn') %></a>
	</nav>
	<a href="/?lang=<%= lang %>" class="logo" aria-label="<%= __('Name') %>"><img src="/img/300sf.svg" alt="" width="128"></a>
</header>

<main>
	<section class="hero wrap">
		<div>
			<h1><%= __('Headline') %></h1>
			<p class="lede"><%= __('Lede') %></p>
			<div class="actions">
				<a class="button" href="https://app.300sf.se/sign-up"><%= __('CreateAccount') %></a>
				<a class="text-link" href="https://app.300sf.se/home"><%= __('HaveAccount') %></a>
			</div>
		</div>

		<figure class="plate" aria-label="<%= __('PlateLabel') %>">
			<div class="plate-head">
				<h2><%= __('PlateTitle') %></h2>
				<span><%= __('PlateExample') %></span>
			</div>
			<ol>
				<% for (const s of __('PlateSpecies')) { %>
				<li class="<%= s.date ? 'seen' : '' %>">
					<span class="mark" aria-hidden="true"></span>
					<span class="species"><b><%= s.name %></b><i lang="la"><%= s.latin %></i></span>
					<span class="date"><%= s.date ? s.date : __('NotYet') %></span>
				</li>
				<% } %>
			</ol>
			<div class="progress">
				<div class="progress-bar" role="presentation"><span style="width: 29%"></span></div>
				<span><%= __('PlateProgress') %></span>
			</div>
		</figure>
	</section>

	<section class="features wrap" aria-label="<%= __('FeaturesLabel') %>">
		<% for (const f of __('Features')) { %>
		<div>
			<h3><%= f.title %></h3>
			<p><%= f.text %></p>
		</div>
		<% } %>
	</section>
</main>

<footer class="site-footer wrap">
	<span>© <%= new Date().getFullYear() %> Angels' Ware</span>
	<nav>
		<a href="https://app.300sf.se/terms"><%= __('Terms') %></a>
		<a href="https://app.300sf.se/privacy-policy"><%= __('Privacy') %></a>
	</nav>
</footer>
