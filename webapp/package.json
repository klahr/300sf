{
  "name": "300sf-webapp",
  "private": true,
  "scripts": {
    "build": "tsc --build src/tsconfig-release.json && terser --compress --mangle -o public/js/app.js -- public/js/app.js",
    "dev": "tsc --build src/tsconfig-debug.json",
    "typecheck": "tsc -p src/tsconfig-release.json --noEmit",
    "start": "node server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "compression": "^1.7.4",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "i18n": "^0.15.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "terser": "^5.51.2",
    "typescript": "^5.9.3"
  }
}
