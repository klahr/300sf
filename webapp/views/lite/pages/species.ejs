<%- contentFor('body') %>

<% if (lang == 'sv') { %>
    <h1><%- data.result.name.sv %> (<%- data.result.order.name.sv %>)</h1>
<% } else { %>
    <h1><%- data.result.name.en %> (<%- data.result.order.name.en %>)</h1>
<% } %>

<p><%- data.wikipedia.summary %></p>
<a href="<%- data.wikipedia.url %>">Read more at Wikipedia</a>

<h2>Pictures</h2>
<% for (image of data.wikipedia.images) { %>
    <a href="<%- image %>"><img src="<%- image %>" width="200" alt="Image of <%- data.result.name.en %>"/></a><br/>
<% } %>


<h2>Recordings</h2>
<% for (recording of data.recordings) { %>
    <a href="<%- recording.url %>"><%- recording.filename %></a><br/>
<% } %>
