{
	"version": "0.2.0",
	"configurations": [
	  {
		"name": "Launch Firefox",
		"type": "firefox",
		"request": "launch",
		"reAttach": true,
		"url": "http://localhost:3000", // Adjust the URL as needed
		"webRoot": "${workspaceFolder}",
		"sourceMapPathOverrides": {
		  "webpack:///./*": "${webRoot}/*"
		}
	  }
	]
  }
  