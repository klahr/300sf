	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch",
			"type": "go",
			"request": "launch",
			"mode": "exec",
			"program": "${workspaceFolder}/bin/300sf",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"env": {
				"LOG_FILE_LOCATION": "${workspaceFolder}/logs/300sf.log"
			},
			"args": ["-config", "${workspaceFolder}/config.yml"]
		}
	]
}