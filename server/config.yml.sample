# Copy to config.yml and fill in. Durations are in seconds.
data-source: "USERNAME:PASSWORD@tcp(127.0.0.1:3306)/300sf?charset=utf8mb4&parseTime=True&loc=Local"
address: "127.0.0.1:8090"  # only nginx on this host should reach it
mode: "release"          # gin mode: debug | release
log-level: "warn"        # silent | error | warn | info
redis-host: "127.0.0.1:6379"
hashing-secret: "change-me"  # signs all tokens; openssl rand -hex 32
domain: "http://localhost:8090"  # public base URL, used in email links
access-token-lifetime: 3600
refresh-token-lifetime: 2592000
default-api-soft-limit: 1000
default-api-hard-limit: 2000
api-call-counter-ttl: 86400
default-lists: []
wikipedia-cache-duration: 604800
mailjet-public-key: ""
mailjet-secret-key: ""
send-email-interval: 0       # 0 disables the email sender
contact-email: ""            # receives the app's contact form; empty turns the form off
delete-accounts-interval: 0  # 0 disables account deletion job
# Names the country, region and municipality of sightings in new places, from
# OpenStreetMap. The public service allows at most 1 request a second for the
# whole site: https://operations.osmfoundation.org/policies/nominatim/
# Run your own Nominatim for more; empty disables it.
geocoder-endpoint: "https://nominatim.openstreetmap.org"
site:
  host: "300sf.se"
  redirect-hosts:
    "www.300sf.se": "/"
    "app.300sf.se": "/home"
    "api-docs.300sf.se": "/docs"
  client-id: ""
  client-secret: ""         # <prefix>.<secret> of the app's API key
  analyze-endpoint: ""      # empty disables bird sound identification
  # Map tiles and their attribution; OpenStreetMap's when empty. Their policy:
  # https://operations.osmfoundation.org/policies/tiles/
  map-tiles: ""
  map-attribution: ""
  # The AGPL asks you to offer your users the source of what runs here. This
  # repository when empty; point it at your fork if you change the code.
  source-url: ""
