<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<title>300sf lite</title>
</head>

<body>
	<h1><%= __('title') %></h1>
	<p>Welcome to the official <%= __('title') %> website. Log in with your credentials.</p>
	<form method="POST" action="/v1/auth">
		<label for="name">Email</label>
		<input id="name" name="email" type="email" required></input>
		<label for="password">Password</label>
		<input id="password" name="password" type="password" required></input>
		<br/>
		<input id="stay_logged_in" name="stay_logged_in" type="checkbox"></input>
		<label for="stay_logged_in">Stay logged in</label>
		<input name="success" type="hidden" value="/lite"></input>
		<br/>
		<button type="submit">Log In</button>
	</form>
</body>

</html>
