<%- contentFor('body') %>

<h1>Lists</h1>
<h2>My Lists</h2>
<table border="1">
    <tr>
        <th>Name</th>
        <th>Visibility</th>
        <th>Species</th>
        <th>From</th>
        <th>Until</th>
    </tr>
    <% for (list of data.lists.result) { %>
        <tr>
            <td>
                <% if (lang == 'sv') { %>
                    <a href="/lite/lists/<%- list.uuid %>"><%- list.name.sv %></a>
                <% } else { %>
                    <a href="/lite/lists/<%- list.uuid %>"><%- list.name.en %></a>
                <% } %>
            </td>
            <td>
                <% if (list.visibility == 0) { %>
                    Private
                <% } else if (list.visibility == 1) { %>
                    Hidden
                <% } else { %>
                    Public
                <% } %>
            </td>
            <td><%- list.species.length %></td>
            <% if (list.from.startsWith('0')) { %>
                <td></td>
            <% } else { %>
                <td><%- list.from %></td>
            <% } %>
            <% if (list.until.startsWith('0')) { %>
                <td></td>
            <% } else { %>
                <td><%- list.until %></td>
            <% } %>
        </tr>
    <% } %>
</table>

<h2>New List</h2>
<form method="POST" action="/lite/list/create">
	<table>
		<tr>
			<td>Name</td>
			<td><input name="name" required></input></td>
		</tr>
		<tr>
			<td>Visbility</td>
			<td>
                <select name="visibility" required>
                    <option value="0">Private</option>
                    <option value="1">Hidden</option>
                    <option value="2">Public</option>
                </select>
            </td>
		</tr>
		<tr>
			<td>Template</td>
			<td>
                <select name="template" required>
                    <% for (template of data.templates.result) { %>
                        <% if (lang == 'sv') { %>
                            <option value="<%- template.uuid %>"><%- template.name.sv %></option>
                        <% } else { %>
                            <option value="<%- template.uuid %>"><%- template.name.en %></option>
                        <% } %>
                    <% } %>
                </select>
            </td>
		</tr>
        <tr>
            <td>From</td>
            <td><input name="from" type="date"></input></td>
        <tr>
            <td>Until</td>
            <td><input name="until" type="date"></input></td>
        </tr>
        </tr>
		<tr>
			<td><button type="submit">Create</button></td>
			<td></td>
		</tr>
	</table>
</form>
