<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<title>300sf lite</title>
</head>

<body>
	<h1>API Keys</h1>
    <h2>My API Keys</h2>
    <table border="1">
        <tr>
            <th>Name</th>
            <th>Prefix</th>
            <th>Scopes</th>
            <th>Request Limit</th>
            <th>Revoked At</th>
        </tr>
    <% for (api_key of data.api_keys) { %>
        <tr>
            <td><%- api_key.name %></td>
            <td><%- api_key.prefix %></td>
            <td><%- api_key.scopes %></td>
            <td><%- api_key.soft_limit %></td>
            <% if (api_key.revoked_at.startsWith('0')) { %>
                <td>
                    <form method="POST" action="/lite/api/revoke">
                        <input type="hidden" name="prefix" value="<%- api_key.prefix %>"></input>
                        <button type="submit">Revoke</button>
                    </form>
                </td>
            <% } else { %>
                <td><%- api_key.revoked_at %></td>
            <% } %>
        </tr>
    <% } %>
    </table>
    <h2>New API Key</h2>
    <form method="POST" action="/lite/api/create">
        <label for="name">Name</label>
        <input name="name" required></input>
        <button type="submit">Create</button>
    </form>
    <% if (typeof new_api_key !== 'undefined') { %>
        <blockquote>Please ensure to securely duplicate this key as retrieval will not be possible thereafter.</blockquote>
        <table border="1">
            <tr>
                <th>Secret Key</th>
            </tr>
            <tr>
                <td><%- new_api_key %></td>
            </tr>
        </table>
    <% } %>
</body>

</html>
