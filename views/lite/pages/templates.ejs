<%- contentFor('body') %>

<h1>Templates</h1>
<h2>My Templates</h2>
<table border="1">
    <tr>
        <th>Name</th>
        <th>Visibility</th>
        <th>Species</th>
    </tr>
    <% for (template of data.result) { %>
        <tr>
            <td>
                <% if (lang == 'sv') { %>
                    <%- template.name.sv %>
                <% } else { %>
                    <%- template.name.en %>
                <% } %>
            </td>
            <td>
                <% if (template.visibility == 0) { %>
                    Private
                <% } else if (template.visibility == 1) { %>
                    Hidden
                <% } else { %>
                    Public
                <% } %>
            </td>
            <td><%- template.species.length %></td>
        </tr>
    <% } %>
</table>
<h2>New Template</h2>
<form method="POST" action="/lite/list_template/create">
	<table>
		<tr>
			<td>Name</td>
			<td><input name="name" required></input></td>
		</tr>
		<tr>
			<td>Visbility</td>
			<td>
                <select name="visibility" required>
                    <option value="0">Private</option>
                    <option value="1">Hidden</option>
                    <option value="2">Public</option>
                </select>
            </td>
		</tr>
		<tr>
			<td>Description</td>
			<td>
                <textarea name="description"></textarea>
            </td>
		</tr>
		<tr>
			<td><button type="submit">Create</button></td>
			<td></td>
		</tr>
	</table>
	<input name="success" type="hidden" value="/lite"></input>
</form>
