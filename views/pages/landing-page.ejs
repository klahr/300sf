	<div style="padding: 16px; box-sizing: border-box;">
		<h1 style="padding-top: 30vh;"><%= __('Title') %></h1>
		<p style="text-shadow: 0.1rem 0.1rem black; font-weight: bold; font-size: 1.4rem;"><%= __('Subtitle') %></p>
		<button onclick="location.href = '//app.300sf.se/signup'" style="margin-top: 30px; max-width: 200px;"><%= __('GetStartedNow') %></button>
	</div>
</div>
<div class="surface" style="margin: 16px auto;">
	<div class="card">
		<center><img src="img/99249498-452f-4b0b-a1f5-45902f7ffe48.png" style="border-radius: 50%;" alt="" width="50%"/></center>
		<img src="img/300sf.svg" alt="" width="128"/>
