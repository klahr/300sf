<%- contentFor('body') %>

<div class="base-frame">
	<a href="/" class="logo" style="margin: 24px 0 64px 0;">300 Svenska Fåglar</a>

	<h2><%= __('sign-in') %></h2>

	<% if (message) { %>
		<p class="message"><%= message %></p>
	<% } %>

	<% if (error) { %>
		<% if (error === "invalid_grant") { %>
			<p class="error">Felaktigt användarnamn eller lösenord.</p>
		<% } else { %>
			<p class="error"><%= error %></p>
		<% } %>
	<% } %>

	<form action="/account/login" method="post">
		<label for="email">Epost</label>
		<input id="email" type="email" name="email" style="margin-bottom: 16px;"></input>
		<label for="password">Lösenord</label>
		<input id="password" type="password" name="password" style="margin-bottom: 16px;"></input>
		<input id="keep_logged_in" type="checkbox" name="keep_logged_in"></input>
		<label for="keep_logged_in">Håll mig inloggad</label>
		<p class="details">Förbli inloggad 1 månad</p>
		<button type="submit" style="margin-top: 16px;"><%= __('sign-in') %></button>
	</form>
	<div class="horizontal-border"></div>
	<p><%= __('no-account-yet') %> <a href="/signup">Skapa konto här</a>.</p>
	<a href="forgot-password">Glömt ditt lösenord?</a>
</div>
