<%- contentFor('body') %>
<div class="surface">
  <center><img src="img/99249498-452f-4b0b-a1f5-45902f7ffe48.png" alt="300sf Sign in" style="width: 50%; border-radius: 50%;"/></center>
  <% if (data.email) { %>
    <p class="success">The account has been successfully created!</p>
  <% } %>
  <h1>Sign in</h1>
  <form method="POST" action="/v1/auth">
    <input type="email" name="email" placeholder="Email" value="<%- data.email %>" required/>
    <input type="password" name="password" placeholder="Password" required/>
    <br/>
    <input name="stay_logged_in" type="checkbox"/>
    <label for="stay_logged_in">Stay signed in</label>
    <p class="details">Please mark the checkbox if you prefer not to sign in during each visit.</p>
    <button>Sign in</button>
	  <input name="success" type="hidden" value="/dashboard"></input>
  </form>
  <hr/>
  <p>Don't have an account yet? <a href="signup">Sign up here</a>.</p>
  <a href="">Forgot your password?</a>
</div>
