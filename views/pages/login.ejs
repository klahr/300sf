<%- contentFor('body') %>
<div class="surface">
  <center><img src="img/logo-256x256.png" alt="300sf Sign in" style="width: 50%; border-radius: 50%;"/></center>
  <h1>Sign in</h1>
  <input type="text" placeholder="Email"/>
  <input type="password" placeholder="Password"/>
  <br/>
  <input name="stay-signed-in" type="checkbox"/>
  <label for="stay-signed-in">Stay signed in</label>
  <p class="details">Please mark the checkbox if you prefer not to sign in during each visit.</p>
  <button>Sign in</button>
  <hr/>
  <p>Don't have an account yet? <a href="">Register here</a></p>
  <a href="">Forgot your password?</a>
</div>
