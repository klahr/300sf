<%- contentFor('body') %>

<div class="base-frame">
	<a href="/" class="logo" style="margin: 24px 0 64px 0;">300 Svenska Fåglar</a>

	<h2><%= __('sign-in') %></h2>

	<% if (message) { %>
		<p class="message"><%= message %></p>
	<% } %>

	<% if (error) { %>
		<% if (error === "invalid_grant") { %>
			<p class="error">Felaktigt användarnamn eller lösenord.</p>
		<% } else { %>
			<p class="error"><%= error %></p>
		<% } %>
	<% } %>

	<form action="/login" method="post">
		<label for="username"><%= __('email') %></label>
		<input id="username" type="text" name="username" style="margin-bottom: 16px;"></input>
		<label for="password"><%= __('password') %></label>
		<input id="password" type="password" name="password" style="margin-bottom: 16px;"></input>
		<input id="keepsignedin" type="checkbox" name="keepsignedin"></input>
		<label for="keepsignedin"><%= __('keep-signed-in-header') %></label>
		<p class="details"><%= __('keep-signed-in-body') %></p>
		<button type="submit" style="margin-top: 16px;"><%= __('sign-in') %></button>
	</form>
	<div class="horizontal-border"></div>
	<p><%= __('no-account-yet') %> <a href="/signup"><%= __('sign-up-here') %></a>.</p>
	<a href="forgot-password"><%= __('forgot-your-password') %></a>
</div>
