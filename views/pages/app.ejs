<%- contentFor('body') %>

<script defer type="text/javascript" src="/js/app.js"></script>
<script type="text/javascript">
	let promptEvent = null;

	window.onpopstate = function (event) {
		window.location.reload();
	};

	window.addEventListener("beforeinstallprompt", (event) => {
		promptEvent = event;
		event.preventDefault();
	});

	function showA2HSPrompt() {
		promptEvent.prompt();
		promptEvent.userChoice.then(handleA2HSResponse);
	}

	function onAppStart() {
		new App("<%- data.language %>", "<%- data.redirect %>", '<%- data.queryParameters %>' !== "" ? JSON.parse('<%- data.queryParameters %>') : {});
	}

	document.querySelector('script[src="/js/app.js"]').onload = onAppStart;
</script>