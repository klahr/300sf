<%- contentFor('body') %>
<div class="surface">
	<center><img src="img/99249498-452f-4b0b-a1f5-45902f7ffe48.png" alt="300sf Sign in" style="width: 50%; border-radius: 50%;"/></center>
	<h1>Create a new account</h1>
	<form method="POST" action="/signup">
		<input type="text" name="display_name" placeholder="Display name" required disabled/>
		<input type="email" name="email" placeholder="Email" required disabled/>
		<input type="password" name="password" placeholder="Password" required disabled/>
		<br/>
		<p class="details">By clicking Sign up you agree to our <a href="terms">Terms of Service</a>.</p>
		<button type="submit" disabled>Sign up (disabled)</button>
	</form>
	<hr/>
	<p>Already have an account yet? <a href="login">Log in here</a>.</p>
</div>
