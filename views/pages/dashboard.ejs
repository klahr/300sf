<%- contentFor('body') %>

<div class="surface">
  <div style="width: 100%; height: 48px; margin-bottom: 16px;">
    <div style="height: 100%; width: calc(100% - 48px); float: left;">
      <span style="font-size: 32px; color: #333;" class="material-symbols-outlined">menu</span>
    </div>
    <div style="width: 48px; height: 100%; float: right; background-image: url(img/logo-256x256.png); background-size: contain; border-radius: 50%;"></div>
  </div>
  <h2>Checklists</h2>
  <div class="card">
    <h3>300 Svenska Fåglar</h3>
    <div>
      <div>
        <div style="width: 80%; background-color: #fc9306;"></div>
      </div>
      <p style="background-color: #fc9306;">240/300</p>
    </div>
    <p>Observed <a href="">Canada Goose</a> on 3 November 2022</p>
  </div>
  <div class="card">
    <h3 style="color: #75b946;">Norske Fugler</h3>
    <div>
      <div>
        <div style="width: 100%; background-color: #7370dd;"></div>
      </div>
      <p style="background-color: #7370dd;">400/400</p>
    </div>
    <span style="font-size: 32px; color: #75b946;" class="material-symbols-outlined">check_circle</span>
  </div>
  <div class="card">
    <h3>Birds of The Earth</h3>
    <div>
      <div>
        <div style="width: 15%; background-color: #940179;"></div>
      </div>
      <p style="background-color: #940179;">1240/6375</p>
    </div>
    <p>Observed <a href="">Eurasian Magpie</a> on 31 December 2009</p>
  </div>
</div>

