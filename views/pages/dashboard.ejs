<%- contentFor('body') %>

<div class="surface">
  <div style="width: 100%; height: 48px; margin-bottom: 16px;">
    <div style="height: 100%; width: calc(100% - 48px); float: left;">
      <span style="font-size: 48px; color: #333;" class="material-symbols-outlined">menu</span>
    </div>
    <div style="width: 48px; height: 100%; float: right; background-image: url(img/logo-256x256.png); background-size: contain; border-radius: 50%;"></div>
  </div>
  <h2>Checklists</h2>
  <div class="card">
    <h3>300 Svenska Fåglar</h3>
    <div style="width: 100%; height: 36px; position: relative;">
      <div style="height: 8px; background-color: #7f7f7f; width: 80%; float: left; border-radius: 4px; position: absolute; top: 50%; transform: translateY(-50%);">
        <div style="height: 100%; background-color: #fc9306; width: 50%; border-radius: inherit;"></div>
      </div>
      <p style="text-align: right; position: absolute; right: 0; padding: 8px; border-radius: 16px; background-color: #fc9306; color: white; font-size: 16px; font-weight: bold;">100/300</p>
    </div>
    <p>Observed <a href="">Canada Goose</a> on 3 November 2022</p>
  </div>
  <div class="card">
    <h3>Epic Birds</h3>
    <div style="width: 100%; height: 36px; position: relative;">
      <div style="height: 8px; background-color: #7f7f7f; width: 80%; float: left; border-radius: 4px; position: absolute; top: 50%; transform: translateY(-50%);">
        <div style="height: 100%; background-color: #dd55dd; width: 50%; border-radius: inherit;"></div>
      </div>
      <p style="text-align: right; position: absolute; right: 0; padding: 8px; border-radius: 16px; background-color: #dd55dd; color: white; font-size: 16px; font-weight: bold;">10/30</p>
    </div>
    <p>Observed <a href="">Eurasian Tit</a> on 2 July 2023</p>
  </div>
</div>
